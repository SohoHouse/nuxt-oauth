{
  "name": "nuxt-oauth",
  "version": "3.0.0",
  "description": "OAuth module for your Nuxt 4 applications",
  "repository": "https://github.com/SohoHouse/nuxt-oauth",
  "license": "MIT",
  "type": "module",
  "main": "./src/module.ts",
  "types": "./src/types.ts",
  "exports": {
    ".": "./src/module.ts",
    "./runtime/*": "./src/runtime/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0",
    "defu": "^6.1.4",
    "ofetch": "^1.4.1"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^3.15.4",
    "@types/node": "^26.2.0",
    "h3": "^1.13.0",
    "nuxt": "4.4.8",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "nuxt": "^3.0.0 || ^4.0.0"
  }
}
