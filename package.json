{
  "name": "nuxt-oauth",
  "version": "3.0.1",
  "description": "OAuth module for your Nuxt 4 applications",
  "repository": "https://github.com/SohoHouse/nuxt-oauth",
  "license": "MIT",
  "type": "module",
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./runtime/*": "./dist/runtime/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0",
    "defu": "^6.1.4",
    "ofetch": "^1.4.1"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/test-utils": "^3.15.4",
    "@types/node": "^26.2.0",
    "h3": "^1.13.0",
    "nuxt": "4.4.8",
    "typescript": "5.9.3",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "nuxt": "^3.0.0 || ^4.0.0"
  }
}
